[node name="InstructionsLabel" type="Label" parent="VBoxContainer" unique_id=885406808]
layout_mode = 2
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 34
text = "You control two climbers who want to climb as high as possible!
A / D / W or Arrows: Walk / Jump or swing on rope / reel in
Space: Anchor active climber and switch
E: Switches without anchoring
Q: Unanchors without switching
F: Boost partner up while unanchored and close
Avoid fragile ice that breaks under you, slippery blue ice that you 
cannot anchor, and falling icicles.
Good luck and enjoy!"

